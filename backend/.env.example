# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Server
PORT=3000

# Database (MySQL/MariaDB dari XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=helpdesk_lite

# Auth (JWT) — isi dengan string acak minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d

# CORS (alamat frontend Angular)
CORS_ORIGIN=http://localhost:4200
